function goHome(){ state.view = "home"; state.form = null; state.reportFolio = null; render(); }

/* ============ HOME ============ */
let homeCache = [];
async function loadHome(){
  homeCache = await getIndex();
  if(state.view === "home") renderHomeList();
}

function renderHome(){
  setTimeout(loadHome, 0);
  return `
    ${topbar("PCA Ingeniería", "REPORTES DE SERVICIO", false)}
    <div class="wrap">
      <button class="btn btn-primary" style="margin-bottom:18px;" onclick="startNuevo()">+ Iniciar nuevo reporte</button>

      <div class="search-box">
        <span class="si">⌕</span>
        <input type="text" placeholder="Buscar por folio, cliente o técnico" oninput="onSearch(this.value)">
      </div>

      <div id="home-list">
        <div class="empty"><span class="loading-dot"></span> Cargando reportes…</div>
      </div>
      <div class="footer-note">Los reportes guardados no pueden editarse una vez generados.</div>
    </div>
  `;
}

function onSearch(v){
  state.search = normalize(v);
  renderHomeList();
}

function renderHomeList(){
  const el = document.getElementById('home-list');
  if(!el) return;
  let list = homeCache;
  if(state.search){
    list = list.filter(r =>
      normalize(r.folio).includes(state.search) ||
      normalize(r.cliente).includes(state.search) ||
      normalize(r.tecnico).includes(state.search)
    );
  }
  if(list.length === 0){
    el.innerHTML = `<div class="empty"><div class="icon">🗂️</div>Aún no hay reportes guardados.<br>Crea el primero con el botón de arriba.</div>`;
    return;
  }
  el.innerHTML = list.map(r => `
    <div class="report-item" onclick="openReport('${r.folio}')">
      <div class="ri-left">
        <b>${escapeHtml(r.cliente || "Sin cliente")}</b>
        <div class="sub">${escapeHtml(r.tecnico)} · ${fmtDate(r.fecha)} · ${escapeHtml(r.tipoServicio)}</div>
        <div class="ri-folio">${r.folio} ${r.local ? '· <span style="color:#C1443A;">no se guardó bien</span>' : ''}</div>
      </div>
      <div class="chev">›</div>
    </div>
  `).join("");
}

function escapeHtml(s){
  return (s||"").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}

function startNuevo(){
  state.form = blankForm();
  state.view = "nuevo";
  render();
}

function openReport(folio){
  state.reportFolio = folio;
  state.view = "ver";
  render();
}

