  .toggle-row{display:flex;align-items:center;justify-content:space-between;gap:10px;}
  .toggle-row .tlabel{font-size:14px;font-weight:600;color:var(--navy);}
  .toggle-row .tsub{font-size:12px;color:var(--muted);font-weight:400;text-transform:none;letter-spacing:0;}
  .switch{position:relative;width:56px;height:30px;border-radius:999px;border:2.5px solid var(--border);background:#fff;cursor:pointer;flex-shrink:0;transition:border-color .15s;}
  .switch.on{border-color:var(--green);}
  .switch .knob{position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:var(--border);transition:all .15s;}
  .switch.on .knob{left:29px;background:var(--navy-2);}

  /* Photos */
  .photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px;}
  .photo-thumb{position:relative;border-radius:10px;overflow:hidden;border:1px solid var(--border);aspect-ratio:1;}
  .photo-thumb img{width:100%;height:100%;object-fit:cover;display:block;}
  .photo-thumb button{
    position:absolute;top:4px;right:4px;background:rgba(11,31,58,.75);color:#fff;border:none;
    width:22px;height:22px;border-radius:50%;font-size:13px;cursor:pointer;line-height:1;
  }
  .photo-add{
    border:1.5px dashed var(--border);border-radius:10px;aspect-ratio:1;display:flex;align-items:center;
    justify-content:center;color:var(--muted);font-size:26px;cursor:pointer;background:#FBFCFB;
  }

  /* Signature pad */
  .sig-wrap{border:1.5px solid var(--border);border-radius:12px;overflow:hidden;background:#fff;}
  .sig-wrap canvas{display:block;width:100%;height:150px;touch-action:none;}
  .sig-actions{display:flex;justify-content:space-between;align-items:center;margin-top:8px;}
  .sig-hint{font-size:11.5px;color:var(--muted);}

  /* List / home */
  .empty{
    text-align:center;padding:40px 20px;color:var(--muted);
  }
  .empty .icon{font-size:34px;margin-bottom:8px;}
  .report-item{
    display:flex;justify-content:space-between;align-items:center;gap:10px;
    padding:14px;border:1px solid var(--border);border-radius:12px;margin-bottom:10px;
    background:#fff;cursor:pointer;
  }
  .report-item:active{background:#F7FAF6;}
  .report-item .ri-left b{display:block;font-size:14.5px;color:var(--navy);}
  .report-item .ri-left .sub{font-size:12.5px;color:var(--muted);margin-top:3px;}
  .report-item .ri-folio{font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--green-dark);font-weight:700;}
  .chev{color:var(--muted);font-size:18px;}

  .search-box{position:relative;margin-bottom:16px;}
  .search-box input{padding-left:38px;}
  .search-box .si{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted);}

  .view-row{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid #F0F2F0;font-size:14px;gap:10px;}
  .view-row:last-child{border-bottom:none;}
  .view-row .k{color:var(--muted);font-weight:500;}
  .view-row .v{color:var(--navy);font-weight:600;text-align:right;}
  .view-text{font-size:14px;color:var(--navy);line-height:1.5;white-space:pre-wrap;}

  .readonly-banner{
    display:flex;align-items:center;gap:8px;background:#FFF8E8;color:#8A6A0E;
    border:1px solid #F3E2B0;border-radius:10px;padding:10px 12px;font-size:12.5px;font-weight:600;margin-bottom:14px;
  }

  .footer-note{text-align:center;font-size:11.5px;color:var(--muted);margin-top:20px;padding:0 10px;}

  .toast{
    position:fixed;bottom:20px;left:50%;transform:translateX(-50%);
    background:var(--navy);color:#fff;padding:12px 20px;border-radius:999px;font-size:13.5px;
    font-weight:600;z-index:60;box-shadow:0 8px 24px rgba(0,0,0,.25);opacity:0;pointer-events:none;
    transition:opacity .2s, transform .2s;
