/* ---- Signature pads ---- */
const sigPads = {};
function setupSignaturePad(canvasId, storeKey){
  const canvas = document.getElementById(canvasId);
  if(!canvas) return;
  const ratio = window.devicePixelRatio || 1;
  const rect = canvas.getBoundingClientRect();
  canvas.width = rect.width * ratio;
  canvas.height = rect.height * ratio;
  const ctx = canvas.getContext('2d');
  ctx.scale(ratio, ratio);
  ctx.fillStyle = "#fff";
  ctx.fillRect(0,0,rect.width,rect.height);
  ctx.strokeStyle = "#0B1F3A";
  ctx.lineWidth = 2.2;
  ctx.lineCap = "round";
  ctx.lineJoin = "round";

  // restore existing signature if present
  const existing = state.form[storeKey];
  if(existing){
    const img = new Image();
    img.onload = ()=> ctx.drawImage(img,0,0,rect.width,rect.height);
    img.src = existing;
  }

  let drawing = false;
  function pos(e){
    const r = canvas.getBoundingClientRect();
    const p = e.touches ? e.touches[0] : e;
    return { x: p.clientX - r.left, y: p.clientY - r.top };
  }
  function start(e){ drawing = true; const p = pos(e); ctx.beginPath(); ctx.moveTo(p.x,p.y); e.preventDefault(); }
  function move(e){ if(!drawing) return; const p = pos(e); ctx.lineTo(p.x,p.y); ctx.stroke(); e.preventDefault(); }
  function end(){ if(!drawing) return; drawing = false; state.form[storeKey] = canvas.toDataURL('image/png'); }

  canvas.addEventListener('mousedown', start);
  canvas.addEventListener('mousemove', move);
  window.addEventListener('mouseup', end);
  canvas.addEventListener('touchstart', start, {passive:false});
  canvas.addEventListener('touchmove', move, {passive:false});
  canvas.addEventListener('touchend', end);

  sigPads[storeKey] = { canvas, ctx };
}
function clearSig(which){
  const key = which === 'cliente' ? 'firmaCliente' : 'firmaTecnico';
  const canvasId = which === 'cliente' ? 'sig-cliente' : 'sig-tecnico';
  state.form[key] = null;
  const canvas = document.getElementById(canvasId);
  if(canvas){
    const rect = canvas.getBoundingClientRect();
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = "#fff";
    ctx.fillRect(0,0,rect.width,rect.height);
  }
}

/* ---- Generar reporte ---- */
async function generarReporte(){
  const f = state.form;
  const nombre = getSelectedTecnico();

  if(!nombre){ toast("Selecciona o escribe el nombre del técnico"); return; }
  if(!f.cliente.trim()){ toast("Ingresa el nombre del cliente"); return; }
  if(!f.firmaCliente || !f.firmaTecnico){ toast("Faltan firmas de cliente y/o técnico"); return; }

  const btn = document.getElementById('btn-generar');
  btn.disabled = true;
  btn.textContent = "Generando…";

  try{
    btn.textContent = "Asignando folio…";
    const folioData = await commitNextFolio(nombre);
    const record = {
      folio: folioData.folio,
      seq: folioData.seq,
      sincronizado: folioData.sincronizado,
      tecnico: nombre,
      cliente: f.cliente,
      sitio: f.sitio,
      fecha: f.fecha,
      tipoServicio: f.tipoServicio,
      equipo: f.equipo, marca: f.marca, modelo: f.modelo, serie: f.serie,
      voltaje: f.voltaje, amperaje: f.amperaje,
      presionAlta: f.presionAlta, presionBaja: f.presionBaja,
      temperaturaEntrada: f.temperaturaEntrada, temperaturaSalida: f.temperaturaSalida,
      detalleServicio: f.detalleServicio,
      observaciones: f.observaciones,
      materiales: f.materiales.filter(m=>m.desc||m.modelo||m.cantidad),
      fotosAntes: f.fotosAntes,
      fotosDespues: f.fotosDespues,
      facturable: f.facturable,
      notaFacturacion: f.notaFacturacion,
      clienteNombreFirma: f.clienteNombreFirma,
      firmaCliente: f.firmaCliente,
      firmaTecnico: f.firmaTecnico,
      creadoEn: new Date().toISOString()
    };

    const sizeBytes = new Blob([JSON.stringify(record)]).size;
    if(sizeBytes > 4.5 * 1024 * 1024){
      throw new Error("El reporte es muy pesado por las fotos adjuntas. Quita algunas fotos e inténtalo de nuevo.");
    }

    // El PDF se genera siempre, sin depender de que el guardado local funcione.
    btn.textContent = "Generando PDF…";
    await generarPDF(record);

    // Guardado en el almacenamiento del dispositivo (IndexedDB). Si por algún
    // motivo falla, el técnico ya tiene su PDF y el reporte queda visible igual.
    btn.textContent = "Guardando reporte…";
    let guardadoOk = true;
    try{
      await saveReport(record.folio, record);
      await addToIndex({
        folio: record.folio, cliente: record.cliente, tecnico: record.tecnico,
        fecha: record.fecha, tipoServicio: record.tipoServicio
      });
    }catch(e){
      console.error("No se pudo guardar en este dispositivo:", e);
      guardadoOk = false;
    }

    viewCache = record;
    homeCache = homeCache.filter(x=>x.folio!==record.folio);
    homeCache.unshift({folio:record.folio, cliente:record.cliente, tecnico:record.tecnico, fecha:record.fecha, tipoServicio:record.tipoServicio, local:!guardadoOk});

    if(guardadoOk){
      toast("Reporte guardado y PDF generado");
    }else{
      toast("PDF descargado. No se pudo guardar el reporte en este dispositivo.");
    }

    state.reportFolio = record.folio;
    state.form = null;
    state.view = "ver";
    render();
  }catch(e){
    console.error(e);
    toast(e.message || "Ocurrió un error al generar el reporte. Inténtalo de nuevo.");
    btn.disabled = false;
    btn.textContent = "Generar reporte y PDF";
  }
}

