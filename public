  .hero{
    display:flex;justify-content:space-between;align-items:flex-start;gap:12px;
    margin-bottom:16px;flex-wrap:wrap;
  }
  .hero img{width:52px;height:52px;border-radius:12px;background:#fff;border:1px solid var(--border);padding:4px;}
  .hero-left{display:flex;gap:12px;align-items:center;}
  .hero-left .co{font-size:13px;font-weight:700;color:var(--navy);line-height:1.15;}
  .hero-left .co span{display:block;font-weight:500;color:var(--muted);font-size:11px;}
  .hero-right{text-align:right;}
  .hero-right h1{font-family:'Space Grotesk',sans-serif;font-size:20px;margin:0;color:var(--navy);}
  .hero-right .tag{color:var(--green-dark);font-weight:700;font-size:13px;}

  /* Materials table */
  .mat-row{display:grid;grid-template-columns:1fr 1fr 60px 34px;gap:8px;margin-bottom:8px;align-items:center;}
  @media (max-width:420px){.mat-row{grid-template-columns:1fr 1fr;grid-template-areas:"desc desc" "mod cant" "del del";}}
  .mat-row input{padding:10px;font-size:13.5px;}
  .rm-row{
    background:#FBEAE8;color:var(--danger);border:none;border-radius:8px;height:38px;width:34px;
    display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;
  }

