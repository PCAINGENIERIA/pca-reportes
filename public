/* ============ PDF ============ */
async function generarPDF(r){
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: "pt", format: "letter" });
  const pageW = doc.internal.pageSize.getWidth();
  const margin = 40;
  let y = 40;

  const navy = [11,31,58];
  const green = [127,190,65];
  const gray = [107,118,134];

  function checkPageBreak(needed){
    if(y + needed > 760){ doc.addPage(); y = 40; }
  }

  // Header
  try{ doc.addImage(LOGO_SRC, 'PNG', margin, y, 34, 34); }catch(e){}
  doc.setFont("helvetica","bold"); doc.setFontSize(13); doc.setTextColor(...navy);
  doc.text("PCA Ingeniería & Automatización", margin+42, y+14);
  doc.setFont("helvetica","normal"); doc.setFontSize(9); doc.setTextColor(...gray);
  doc.text("Servicios & Mantenimiento", margin+42, y+27);

  doc.setFont("helvetica","bold"); doc.setFontSize(15); doc.setTextColor(...navy);
  doc.text("REPORTE TÉCNICO", pageW-margin, y+14, {align:"right"});
  doc.setFillColor(...navy);
  doc.roundedRect(pageW-margin-140, y+22, 140, 18, 9, 9, 'F');
  doc.setFont("courier","bold"); doc.setFontSize(9.5); doc.setTextColor(255,255,255);
  doc.text(r.folio, pageW-margin-70, y+34, {align:"center"});

  y += 50;
  doc.setDrawColor(...green); doc.setLineWidth(2);
  doc.line(margin, y, pageW-margin, y);
  y += 20;

  function sectionTitle(t){
    checkPageBreak(30);
    doc.setFont("helvetica","bold"); doc.setFontSize(10.5); doc.setTextColor(...navy);
    doc.text(t.toUpperCase(), margin, y);
    doc.setDrawColor(...green); doc.setLineWidth(1.2);
    doc.line(margin, y+4, pageW-margin, y+4);
    y += 18;
  }

  function fieldPair(labels, values, colWidth){
    checkPageBreak(30);
    const cw = colWidth || (pageW - margin*2)/2;
    labels.forEach((lab, i)=>{
      const x = margin + i*cw;
      doc.setFont("helvetica","bold"); doc.setFontSize(8); doc.setTextColor(...gray);
      doc.text(lab.toUpperCase(), x, y);
      doc.setFont("helvetica","normal"); doc.setFontSize(10.5); doc.setTextColor(...navy);
      const val = values[i] || "—";
      doc.text(doc.splitTextToSize(val, cw-14), x, y+13);
    });
    y += 30;
  }

  sectionTitle("Datos generales");
  fieldPair(["Técnico responsable","N° Correlativo"], [r.tecnico, String(r.seq)]);
  fieldPair(["Cliente","Sitio / Ubicación"], [r.cliente, r.sitio]);
  fieldPair(["Fecha","Tipo de servicio"], [fmtDate(r.fecha), r.tipoServicio]);

  y += 6;
  sectionTitle("Datos y lecturas del equipo");
  fieldPair(["Equipo","Marca"], [r.equipo, r.marca]);
  fieldPair(["Modelo","No. Serie"], [r.modelo, r.serie]);
  fieldPair(["Voltaje","Amperaje"], [r.voltaje, r.amperaje]);
  fieldPair(["Presión alta","Presión baja"], [r.presionAlta, r.presionBaja]);
  fieldPair(["Temperatura entrada","Temperatura salida"], [r.temperaturaEntrada, r.temperaturaSalida]);

  y += 6;
  sectionTitle("Detalle del servicio realizado");
  doc.setFont("helvetica","normal"); doc.setFontSize(10); doc.setTextColor(...navy);
  let lines = doc.splitTextToSize(r.detalleServicio || "—", pageW-margin*2);
  checkPageBreak(lines.length*13+10);
  doc.text(lines, margin, y); y += lines.length*13 + 14;

  doc.setFont("helvetica","bold"); doc.setFontSize(8); doc.setTextColor(...gray);
  checkPageBreak(15);
  doc.text("OBSERVACIONES TÉCNICAS", margin, y); y += 13;
  doc.setFont("helvetica","normal"); doc.setFontSize(10); doc.setTextColor(...navy);
  lines = doc.splitTextToSize(r.observaciones || "—", pageW-margin*2);
  checkPageBreak(lines.length*13+10);
  doc.text(lines, margin, y); y += lines.length*13 + 16;

  if(r.materiales && r.materiales.length){
    sectionTitle("Materiales / repuestos utilizados");
    doc.setFont("helvetica","bold"); doc.setFontSize(8.5); doc.setTextColor(...gray);
    doc.text("DESCRIPCIÓN", margin, y); doc.text("MODELO", margin+260, y); doc.text("CANT.", margin+400, y);
    y += 10;
    doc.setDrawColor(220,220,220); doc.line(margin, y, pageW-margin, y); y += 12;
    doc.setFont("helvetica","normal"); doc.setFontSize(9.5); doc.setTextColor(...navy);
    r.materiales.forEach(m=>{
      checkPageBreak(16);
      doc.text(doc.splitTextToSize(m.desc||"—",240), margin, y);
      doc.text(m.modelo||"—", margin+260, y);
      doc.text(String(m.cantidad||"—"), margin+400, y);
      y += 16;
    });
    y += 8;
  }

  sectionTitle("Facturación");
  fieldPair(["Aprobado para facturar","Nota"], [r.facturable ? "Sí" : "No", r.notaFacturacion || "—"]);

  // Photos
  async function addPhotoSection(title, photos){
    if(!photos || !photos.length) return;
    sectionTitle(title);
    const perRow = 3, gap = 10;
    const imgW = (pageW - margin*2 - gap*(perRow-1))/perRow;
    const imgH = imgW*0.75;
    let x = margin;
    let rowMaxH = 0;
    checkPageBreak(imgH+10);
    photos.forEach((p,i)=>{
      if(i>0 && i%perRow===0){ y += imgH+gap; x = margin; checkPageBreak(imgH+10); }
      try{ doc.addImage(p, 'JPEG', x, y, imgW, imgH); }catch(e){}
      x += imgW+gap;
      rowMaxH = imgH;
    });
    y += rowMaxH + 20;
  }
  await addPhotoSection("Fotografías — Antes", r.fotosAntes);
  await addPhotoSection("Fotografías — Después", r.fotosDespues);

  // Signatures
  sectionTitle("Firmas de conformidad");
  checkPageBreak(110);
  const sigW = (pageW-margin*2-20)/2;
  try{ doc.addImage(r.firmaCliente, 'PNG', margin, y, sigW, 70); }catch(e){}
  try{ doc.addImage(r.firmaTecnico, 'PNG', margin+sigW+20, y, sigW, 70); }catch(e){}
  y += 74;
  doc.setDrawColor(200,200,200);
  doc.line(margin, y, margin+sigW, y);
  doc.line(margin+sigW+20, y, margin+sigW*2+20, y);
  y += 12;
  doc.setFont("helvetica","bold"); doc.setFontSize(9); doc.setTextColor(...navy);
  doc.text(r.clienteNombreFirma || "Cliente", margin, y);
  doc.text(r.tecnico, margin+sigW+20, y);
  doc.setFont("helvetica","normal"); doc.setFontSize(8); doc.setTextColor(...gray);
  doc.text("Firma de conformidad — Cliente", margin, y+11);
  doc.text("Firma — Técnico responsable", margin+sigW+20, y+11);

  doc.save(`${r.folio}.pdf`);
}

