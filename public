  "name": "PCA Ingeniería - Reportes de Servicio",
  "short_name": "PCA Reportes",
  "description": "App de reportes técnicos de servicio y mantenimiento - PCA Ingeniería & Automatización",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F5F3",
  "theme_color": "#0B1F3A",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
