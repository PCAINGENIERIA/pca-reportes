  { nombre: "Alberto Zumarraga", code: "ABZ" },
  { nombre: "Alejandro Zumarraga", code: "ALZ" },
  { nombre: "Alfredo Zumarraga", code: "AFZ" },
  { nombre: "Arturo Avilez", code: "AAV" },
  { nombre: "Cesar Centeno", code: "CCE" },
  { nombre: "Nicolas Martinez", code: "NMA" },
  { nombre: "Oscar Flores", code: "OFL" },
  { nombre: "Roman Palma", code: "RPA" },
  { nombre: "Sebastian Zumarraga", code: "SZU" }
].sort((a,b)=>a.nombre.localeCompare(b.nombre,'es'));

const TIPOS_SERVICIO = ["Preventivo","Correctivo","Mantenimiento","Instalación","Diagnóstico"];

/* ============ UTILIDADES ============ */
function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(()=>t.classList.remove('show'), 2600);
}

function normalize(str){
  return (str||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toUpperCase();
}

function codeFromFreeName(name){
  const parts = normalize(name).trim().split(/\s+/).filter(Boolean);
  if(parts.length === 0) return "TEC";
  if(parts.length === 1) return (parts[0].slice(0,3)).padEnd(3,"X");
  let code = parts[0][0] + parts[0].slice(1,2) + parts[parts.length-1][0];
  code = code.replace(/[^A-Z]/g,"X");
  return code.padEnd(3,"X").slice(0,4);
}

function getTechCode(nombre){
  const found = TECNICOS.find(t=>t.nombre === nombre);
  if(found) return found.code;
  return codeFromFreeName(nombre);
}

function todayISO(){
  const d = new Date();
  const off = d.getTimezoneOffset();
  const local = new Date(d.getTime() - off*60000);
  return local.toISOString().slice(0,10);
}

function fmtDate(iso){
  if(!iso) return "";
  const [y,m,d] = iso.split("-");
  return `${d}/${m}/${y}`;
}

function uid(){
  return Math.random().toString(36).slice(2,9);
}

/* ============ ALMACENAMIENTO LOCAL (IndexedDB del propio navegador) ============ */
/* Ya no depende del almacenamiento de Claude: los datos viven en el teléfono/PC
   donde se abre esta app, igual que cualquier app instalada. */
const DB_NAME = "pca_reportes_db";
const DB_STORE = "kv";
let _dbPromise = null;

function openDB(){
  if(_dbPromise) return _dbPromise;
  _dbPromise = new Promise((resolve, reject)=>{
    if(!window.indexedDB){ reject(new Error("Este navegador no soporta almacenamiento local")); return; }
    const req = indexedDB.open(DB_NAME, 1);
    req.onupgradeneeded = ()=>{
      const db = req.result;
      if(!db.objectStoreNames.contains(DB_STORE)) db.createObjectStore(DB_STORE);
    };
    req.onsuccess = ()=> resolve(req.result);
    req.onerror = ()=> reject(req.error || new Error("No se pudo abrir el almacenamiento local"));
  });
  return _dbPromise;
}

async function safeGet(key){
  try{
    const db = await openDB();
    return await new Promise((resolve, reject)=>{
      const tx = db.transaction(DB_STORE, "readonly");
      const req = tx.objectStore(DB_STORE).get(key);
      req.onsuccess = ()=> resolve(req.result === undefined ? null : req.result);
      req.onerror = ()=> reject(req.error);
    });
  }catch(e){
    console.error("storage get error", e);
    return null;
  }
}
async function safeSet(key, value){
  try{
    const db = await openDB();
    return await new Promise((resolve, reject)=>{
      const tx = db.transaction(DB_STORE, "readwrite");
      tx.objectStore(DB_STORE).put(value, key);
      tx.oncomplete = ()=> resolve(true);
      tx.onerror = ()=> reject(tx.error);
    });
  }catch(e){
    console.error("storage set error", e);
    throw new Error(`No se pudo guardar "${key}" en este dispositivo`);
  }
}

/* ============ FOLIOS ============ */
async function peekNextFolio(nombre){
  if(!nombre) return null;
  const code = getTechCode(nombre);
  const year = new Date().getFullYear();
  const key = `contador:${code}:${year}`;
  const raw = await safeGet(key);
  const current = raw ? parseInt(raw,10) : 0;
  const next = current + 1;
  return { folio: `PCA-${code}-${year}-${String(next).padStart(3,"0")}`, seq: next, code, year };
}

async function commitNextFolio(nombre){
  const code = getTechCode(nombre);
  const year = new Date().getFullYear();
  const key = `contador:${code}:${year}`;
  const raw = await safeGet(key);
  const current = raw ? parseInt(raw,10) : 0;
  const next = current + 1;
  await safeSet(key, String(next));
  return { folio: `PCA-${code}-${year}-${String(next).padStart(3,"0")}`, seq: next, code, year, sincronizado: true };
}

/* ============ INDICE DE REPORTES ============ */
async function getIndex(){
  const raw = await safeGet("reportes-indice");
  if(!raw) return [];
  try{ return JSON.parse(raw); }catch(e){ return []; }
}
async function addToIndex(entry){
  const list = await getIndex();
  list.unshift(entry);
  await safeSet("reportes-indice", JSON.stringify(list));
}
async function getReport(folio){
  const raw = await safeGet(`reporte:${folio}`);
  if(!raw) return null;
  try{ return JSON.parse(raw); }catch(e){ return null; }
}
async function saveReport(folio, data){
  await safeSet(`reporte:${folio}`, JSON.stringify(data));
}

/* ============ IMAGENES ============ */
function compressImage(file, maxW=640, quality=0.5){
  return new Promise((resolve,reject)=>{
    const reader = new FileReader();
    reader.onload = e =>{
      const img = new Image();
      img.onload = ()=>{
        let w = img.width, h = img.height;
        if(w > maxW){ h = Math.round(h * (maxW/w)); w = maxW; }
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = "#fff"; ctx.fillRect(0,0,w,h);
        ctx.drawImage(img,0,0,w,h);
        resolve(canvas.toDataURL('image/jpeg', quality));
      };
      img.onerror = reject;
      img.src = e.target.result;
    };
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}

